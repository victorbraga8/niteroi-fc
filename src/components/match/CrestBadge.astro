---
import { Image } from 'astro:assets'
import type { Club } from '../../data/types'

interface Props {
  club: Club
  size?: number
  class?: string
}

const { club, size = 72, class: className } = Astro.props
---

{
  club.crest ? (
    <Image
      src={club.crest}
      alt={`Escudo do ${club.name}`}
      width={size}
      height={size}
      densities={[1, 2]}
      class:list={['object-contain', className]}
      style={`width:${size}px;height:${size}px;`}
      data-slot="crest-badge"
    />
  ) : (
    <span
      class:list={['inline-grid place-items-center border border-[var(--surface-line)]', className]}
      style={`width:${size}px;height:${size}px;border-radius:999px;`}
      aria-label={`Escudo do ${club.name} indisponível`}
      data-slot="crest-badge"
    >
      <span class="text-xs font-bold tracking-[0.1em] text-[var(--ink-faint)]">
        {club.shortName}
      </span>
    </span>
  )
}
