---
import { Image } from 'astro:assets'
import PitchBento from './PitchBento.astro'
import { protagonist, squad, squadSize, headCoach, staff } from '../../data/squad'

/**
 * QUEM JOGA
 *
 * The club published one athlete portrait for this squad and no shirt numbers,
 * so the section is built around what is real: one protagonist introduction
 * with a photograph and his own words, and the full announced group presented
 * as names at scale. No placeholder faces, no invented numbers, no catalogue
 * of identical cards.
 */
---

<section id="quem-joga" class="relative" aria-labelledby="quem-joga-titulo">
  <div class="shell pt-[clamp(2rem,5vh,3.5rem)]">
    <h2 id="quem-joga-titulo" class="t-headline text-white" data-reveal>Quem joga</h2>
  </div>

  <!-- Protagonist: large photography, monumental name, layered depth. -->
  <div class="shell mt-10 lg:mt-16">
    <div
      class="relative grid items-end gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:gap-12"
      data-protagonist
    >
      <div class="relative z-10 order-2 lg:order-1">
        <p class="t-label mb-4" data-reveal>
          {protagonist.role} / {protagonist.age} anos / {protagonist.origin}
        </p>

        <p
          class="t-monument text-white"
          style="font-size: clamp(4.5rem, 15vw, 11rem);"
          data-protagonist-name
        >
          {protagonist.name}
        </p>

        <blockquote class="mt-8 max-w-[34ch]" data-reveal>
          <p
            class="text-[1.35rem] leading-[1.22] font-semibold text-white lg:text-[1.6rem]"
            style="font-family: var(--font-display), sans-serif;"
          >
            “{protagonist.quote}”
          </p>
          <footer class="mt-3 text-[0.8125rem] text-[var(--ink-faint)]">
            {protagonist.quoteContext}
          </footer>
        </blockquote>

        <ul class="mt-8 space-y-2.5" data-reveal>
          {
            protagonist.background.map((fact) => (
              <li class="flex gap-3 text-[0.9375rem] text-[var(--ink-muted)]">
                <span class="mt-[0.62em] h-px w-4 shrink-0" style="background: var(--accent-bright);" aria-hidden="true" />
                <span>{fact}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Photography sits inside the arc, the same curve the crest carries. -->
      <div class="relative order-1 overflow-hidden lg:order-2">
        <div
          class="pointer-events-none absolute inset-x-[-8%] bottom-[-6%] top-[12%] -z-10"
          style="background: linear-gradient(180deg, var(--surface-raised), transparent 72%); border-radius: 50% 50% 0 0 / 28% 28% 0 0;"
          aria-hidden="true"
        >
        </div>
        <Image
          src={protagonist.portrait}
          alt={protagonist.portraitAlt}
          widths={[420, 584]}
          sizes="(min-width: 1024px) 34rem, 78vw"
          class="shape-arc-up mx-auto w-full max-w-[30rem] object-cover"
          loading="lazy"
          data-protagonist-portrait
        />
      </div>
    </div>
  </div>

  <!-- The pitch as the club photographed it, between protagonist and group. -->
  <div class="mt-[clamp(4rem,10vh,7rem)]">
    <PitchBento />
  </div>

  <!-- The announced group. Names carry the section; the filter is the interaction. -->
  <div class="shell mt-[clamp(3rem,7vh,5rem)] pb-[clamp(5rem,11vh,8rem)]">
    <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-4">
      <h3 class="t-subhead text-white" data-reveal>
        O grupo de {squadSize} jogadores
      </h3>
      <p class="text-[0.875rem] text-[var(--ink-muted)]">
        Sob o comando de <strong class="font-bold text-white">{headCoach}</strong>
      </p>
    </div>

    <div class="mt-7 flex flex-wrap gap-2" role="group" aria-label="Filtrar por posição">
      <button
        type="button"
        class="squad-filter"
        data-squad-filter="todos"
        aria-pressed="true"
      >
        Todos
      </button>
      {
        squad.map((group) => (
          <button
            type="button"
            class="squad-filter"
            data-squad-filter={group.id}
            aria-pressed="false"
          >
            {group.label}
          </button>
        ))
      }
    </div>

    <!-- Every name stays in place at every filter. Choosing a position dims
         the rest rather than removing it, so the list never reflows and the
         eye only has to follow the highlight. -->
    <div class="mt-9 grid gap-x-10 gap-y-9 sm:grid-cols-2 xl:grid-cols-4" data-squad-list>
      {
        squad.map((group) => (
          <section class="squad-group" data-squad-group={group.id}>
            <h4 class="squad-group__label">{group.label}</h4>
            <ul class="mt-3 space-y-1">
              {group.players.map((name) => (
                <li class="squad-name" data-squad-name>
                  {name}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <div class="mt-[clamp(3rem,7vh,5rem)]">
      <h3 class="t-label mb-4">Comissão técnica</h3>
      <ul class="grid gap-x-8 gap-y-3 sm:grid-cols-2 xl:grid-cols-3">
        {
          staff.map((member) => (
            <li class="flex items-baseline justify-between gap-4 border-b border-[var(--surface-line)] pb-2.5">
              <span class="font-semibold text-white">{member.name}</span>
              <span class="text-right text-[0.8125rem] text-[var(--ink-faint)]">{member.role}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .squad-filter {
    border: 1px solid var(--surface-line);
    border-radius: 999px;
    padding: 0.6rem 1.1rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    background: transparent;
    cursor: pointer;
    min-height: 44px;
    transition:
      color var(--dur-fast) ease,
      border-color var(--dur-fast) ease,
      background var(--dur-fast) ease;
  }

  .squad-filter:hover {
    color: #fff;
    border-color: var(--accent-bright);
  }

  .squad-filter[aria-pressed='true'] {
    background: var(--nfc-azul);
    border-color: var(--nfc-azul);
    color: #fff;
  }

  .squad-filter:active {
    transform: translateY(1px);
  }

  .squad-group__label {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-bright);
    transition: color 320ms var(--ease-athletic);
  }

  .squad-name {
    font-family: var(--font-display), sans-serif;
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #fff;
    transition:
      color 320ms var(--ease-athletic),
      opacity 320ms var(--ease-athletic);
  }

  /* Dimmed, not hidden: the group keeps its shape and its height. */
  .squad-group[data-dimmed='true'] .squad-group__label {
    color: var(--ink-faint);
  }

  .squad-group[data-dimmed='true'] .squad-name {
    color: var(--ink-faint);
    opacity: 0.4;
  }

  @media (prefers-reduced-motion: reduce) {
    .squad-group__label,
    .squad-name {
      transition: none;
    }
  }
</style>
