---
import { Image } from 'astro:assets'
import acaoRiostrense from '../../assets/media/acao-riostrense-2024.jpg'
import campoCaac from '../../assets/media/campo-caac-2024.jpg'
import campoParaty from '../../assets/media/campo-paraty-2024.jpg'

/**
 * The pitch, as the club actually photographed it.
 *
 * Three real frames from Niteroiense TV, each captioned with the match it came
 * from and each opening full size. The grid is asymmetric on purpose: three
 * items, three cells, no filler tile.
 */

const frames = [
  {
    image: acaoRiostrense,
    alt: 'Jogadores do Niteroiense em movimento durante partida da Série C de 2024',
    match: 'Niteroiense 2 x 0 Riostrense',
    meta: 'Carioca Série C 2024, 7ª rodada',
    span: 'wide' as const,
  },
  {
    image: campoCaac,
    alt: 'Lance de ataque com prédios e morros de Niterói ao fundo do campo',
    match: 'CAAC Brasil 1 x 4 Niteroiense',
    meta: 'Carioca Série C 2024, 8ª rodada',
    span: 'tall' as const,
  },
  {
    image: campoParaty,
    alt: 'Partida do Niteroiense vista da arquibancada',
    match: 'Paraty 1 x 4 Niteroiense',
    meta: 'Carioca Série C 2024, 4ª rodada',
    span: 'tall' as const,
  },
]
---

<div class="bento" data-reveal>
  {
    frames.map((frame) => (
      <a
        href={frame.image.src}
        class:list={['bento__cell', `bento__cell--${frame.span}`]}
        data-lightbox="campo"
        data-type="image"
        data-title={frame.match}
        data-description={frame.meta}
        aria-label={`Ampliar imagem: ${frame.match}`}
      >
        <Image
          src={frame.image}
          alt={frame.alt}
          widths={[640, 1280]}
          sizes="(min-width: 1024px) 46rem, 94vw"
          class="bento__image"
          loading="lazy"
        />
        <span class="bento__veil" />
        <span class="bento__body">
          <span class="bento__match">{frame.match}</span>
          <span class="bento__meta">{frame.meta}</span>
        </span>
        <span class="bento__zoom" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.5-3.5M11 8v6M8 11h6" stroke-linecap="round" />
          </svg>
        </span>
      </a>
    ))
  }
</div>

<style>
  .bento {
    display: grid;
    gap: 0.75rem;
    padding-inline: var(--gutter);
  }

  @media (min-width: 768px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(2, minmax(0, 1fr));
      height: clamp(26rem, 46vw, 34rem);
    }

    .bento__cell--wide {
      grid-row: span 2;
    }
  }

  .bento__cell {
    position: relative;
    display: block;
    overflow: hidden;
    min-height: 11rem;
    background: var(--surface-deep);
    border: 1px solid var(--surface-line);
    transition:
      border-color 280ms var(--ease-athletic),
      transform 380ms var(--ease-athletic);
  }

  .bento__cell:hover,
  .bento__cell:focus-visible {
    border-color: var(--accent-bright);
  }

  .bento__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-athletic);
  }

  .bento__cell:hover .bento__image,
  .bento__cell:focus-visible .bento__image {
    transform: scale(1.05);
  }

  .bento__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(6, 12, 28, 0.06) 0%,
      rgba(6, 12, 28, 0.5) 56%,
      rgba(6, 12, 28, 0.9) 100%
    );
  }

  .bento__body {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: clamp(1rem, 2vw, 1.5rem);
  }

  .bento__match {
    font-family: var(--font-display), sans-serif;
    font-size: clamp(1.05rem, 1.7vw, 1.4rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #fff;
  }

  .bento__meta {
    font-size: 0.8125rem;
    color: var(--ink-muted);
  }

  .bento__zoom {
    position: absolute;
    top: clamp(0.9rem, 1.8vw, 1.35rem);
    right: clamp(0.9rem, 1.8vw, 1.35rem);
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 999px;
    background: rgba(6, 12, 28, 0.45);
    color: #fff;
    backdrop-filter: blur(6px);
    opacity: 0;
    transform: scale(0.9);
    transition:
      opacity 260ms var(--ease-athletic),
      transform 260ms var(--ease-athletic),
      background 260ms var(--ease-athletic);
  }

  .bento__cell:hover .bento__zoom,
  .bento__cell:focus-visible .bento__zoom {
    opacity: 1;
    transform: scale(1);
    background: var(--nfc-azul);
    border-color: var(--nfc-azul);
  }

  @media (prefers-reduced-motion: reduce) {
    .bento__cell,
    .bento__image,
    .bento__zoom {
      transition: none;
    }
    .bento__cell:hover .bento__image {
      transform: none;
    }
    .bento__zoom {
      opacity: 1;
      transform: none;
    }
  }
</style>
