---
interface Props {
  /** Omit to render the same content as plain text instead of a link. */
  href?: string
  class?: string
  external?: boolean
  'aria-label'?: string
}

const { href, class: className, external, ...rest } = Astro.props

/**
 * A link where there is somewhere to go, and the same markup without one where
 * there is not. It exists so withholding an outbound link never costs the
 * content that link was wrapping.
 */
---

{
  href ? (
    <a
      href={href}
      class={className}
      {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <span class={className} {...rest}>
      <slot />
    </span>
  )
}
