---
import { Image } from 'astro:assets'
import crestNegativo from '../../assets/brand/nfc-crest-negativo.png'
import { club } from '../../data/club'

/**
 * The entrance.
 *
 * The crest is held on a full field of Azul Itaipu while the page loads, with
 * a real progress read-out and the MAC arc filling underneath it. At 100% the
 * crest travels into the position it occupies behind the opening scene, so the
 * loader does not disappear: it becomes the background of the hero.
 *
 * Markup is inert to assistive tech and removed from the DOM once it is done,
 * so it never sits in the tab order or in front of the content.
 */
---

<div class="preloader" data-preloader aria-hidden="true">
  <div class="preloader__field">
    <div class="preloader__crest" data-preloader-crest>
      <Image
        src={crestNegativo}
        alt=""
        width={760}
        height={760}
        densities={[1, 2]}
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="preloader__meter">
      <p class="preloader__wordmark">
        <span>Niteroiense</span> Futebol Clube
      </p>

      <p class="preloader__count">
        <span class="t-score" data-preloader-count>00</span><span class="preloader__percent">%</span>
      </p>

      <!-- The MAC arc, filling. Same curve as the crest above it. -->
      <svg class="preloader__arc" viewBox="0 0 320 76" fill="none" aria-hidden="true">
        <path
          d="M4 72 A 222 222 0 0 1 316 72"
          stroke="currentColor"
          stroke-width="2"
          opacity="0.2"
          stroke-linecap="round"></path>
        <path
          d="M4 72 A 222 222 0 0 1 316 72"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          data-preloader-arc
          pathLength="1"></path>
      </svg>

      <p class="preloader__caption">{club.competition}</p>
    </div>
  </div>
</div>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    background: var(--nfc-itaipu);
    color: #fff;
    /* The curtain leaves through the same arc the rest of the page uses. */
    clip-path: ellipse(150% 150% at 50% 50%);
  }

  .preloader[data-done='true'] {
    display: none;
  }

  .preloader__field {
    display: flex;
    width: 100%;
    max-width: 30rem;
    flex-direction: column;
    align-items: center;
    padding-inline: var(--gutter);
  }

  .preloader__crest {
    width: clamp(7rem, 26vw, 11rem);
    will-change: transform, opacity;
  }

  .preloader__crest :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .preloader__meter {
    margin-top: clamp(2rem, 5vh, 3rem);
    width: 100%;
    text-align: center;
  }

  .preloader__wordmark {
    font-family: var(--font-display), sans-serif;
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.62);
  }

  .preloader__wordmark span {
    font-weight: 800;
    color: #fff;
  }

  .preloader__count {
    margin-top: 0.9rem;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.1em;
    font-size: clamp(3.5rem, 12vw, 5.5rem);
    line-height: 0.8;
  }

  .preloader__percent {
    font-family: var(--font-display), sans-serif;
    font-size: 0.28em;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--accent-bright);
  }

  .preloader__arc {
    margin-top: 1.1rem;
    display: block;
    width: 100%;
    height: auto;
    color: var(--accent-bright);
  }

  .preloader__arc [data-preloader-arc] {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .preloader__caption {
    margin-top: 0.35rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.48);
  }

  /* Without scripting there is nothing to wait for, so there is no curtain. */
  html:not(.motion-ready) .preloader {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .preloader {
      display: none;
    }
  }
</style>
