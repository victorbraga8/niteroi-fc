---
import { Image } from 'astro:assets'
import Crest from '../ui/Crest.astro'
import Wordmark from '../ui/Wordmark.astro'
import MaybeLink from '../ui/MaybeLink.astro'
import golResende from '../../assets/media/gol-resende-2024.jpg'
import { club, social } from '../../data/club'
import { linkOutToOfficialSite } from '../../config/experience'

/** One mark per network, drawn plainly enough to hold at 20px. */
const socialIcons: Record<string, string> = {
  Instagram:
    '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"/>',
  YouTube:
    '<rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10.5 9.4 15.2 12l-4.7 2.6Z" fill="currentColor" stroke="none"/>',
  TikTok:
    '<path d="M14.7 3.5c.5 2.1 2 3.5 4.1 3.7v2.7c-1.5 0-2.9-.4-4.1-1.3v5.9a5 5 0 1 1-4.3-4.9v2.7a2.3 2.3 0 1 0 1.7 2.2V3.5Z" fill="currentColor" stroke="none"/>',
  Threads:
    '<path d="M12 21c-4.6 0-7-2.8-7-7.5V10c0-4.1 2.5-7 6.9-7 4 0 6.1 2.3 6.3 5.5"/><path d="M17.2 12.6c0 3-1.7 4.7-4.1 4.7-1.8 0-3.1-1-3.1-2.6 0-1.8 1.6-2.7 3.6-2.7 1 0 2 .1 2.9.4"/>',
  X: '<path d="M5 5l14 14M19 5 5 19"/>',
  Facebook:
    '<path d="M14 21v-7h2.4l.4-3H14V9c0-.9.3-1.5 1.7-1.5H17V4.8c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3V11H8v3h2.3v7Z" fill="currentColor" stroke="none"/>',
}
---

<!--
  The page closes on the squad together after a goal: the one photograph the
  club owns that is about the group rather than about the ball. It is credited
  with the match it came from, and pushed back far enough to read as ground.
-->
<footer class="site-footer relative overflow-hidden">
  <div class="site-footer__bg" aria-hidden="true">
    <Image
      src={golResende}
      alt=""
      widths={[960, 1280]}
      sizes="100vw"
      class="site-footer__photo"
      loading="lazy"
    />
    <span class="site-footer__duotone"></span>
    <span class="site-footer__veil"></span>
  </div>

  <div class="shell relative z-10 py-[clamp(3.5rem,8vh,5.5rem)]">
    <div class="flex flex-wrap items-start justify-center md:justify-between gap-x-12 gap-y-10">
      <div>
        <div class="flex items-center gap-5">
          <Crest size={96} class="site-footer__crest" />
          <Wordmark class="text-[clamp(19px,2.4vw,26px)] text-white" />
        </div>
        <p class="mt-6 max-w-[34ch] text-[0.9375rem] leading-relaxed text-[var(--ink-muted)]">
          Fundado em {club.founded}. De volta aos gramados desde {club.refoundedYear}, mandante na
          {' '}{club.homeVenue}.
        </p>
      </div>

      <nav aria-label="Redes sociais">
        <h2 class="t-label mb-4 text-[0.8125rem]">Redes</h2>
        <ul class="flex items-center gap-3">
          {
            social.map((item) => (
              <li>
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="site-footer__social"
                  aria-label={item.label}
                  title={item.label}
                >
                  <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" set:html={socialIcons[item.label] ?? ''} />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <!-- Copyright is a rule at the bottom of the page, not a block of its own. -->
  <div class="site-footer__legal relative z-10">
    <div class="shell flex min-h-10 flex-wrap items-center justify-center gap-x-4 gap-y-1 py-2 text-center">
      <p>© {new Date().getFullYear()} {club.name}</p>
      <p>
        Conteúdo e imagens do{' '}
        <MaybeLink
          href={linkOutToOfficialSite ? club.site : undefined}
          class={linkOutToOfficialSite
            ? 'underline underline-offset-2 transition-colors hover:text-white'
            : undefined}
          external
        >
          site oficial
        </MaybeLink>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface-abyss);
  }

  .site-footer__bg {
    position: absolute;
    inset: 0;
  }

  .site-footer__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 34%;
    transform: scale(1.06);
    filter: blur(3px) saturate(1.12);
  }

  .site-footer__duotone {
    position: absolute;
    inset: 0;
    background: linear-gradient(200deg, #16305e 0%, #060c1c 100%);
    mix-blend-mode: multiply;
  }

  .site-footer__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(6, 12, 28, 0.88) 0%,
      rgba(6, 12, 28, 0.7) 44%,
      rgba(6, 12, 28, 0.93) 100%
    );
  }

  .site-footer__crest {
    width: clamp(68px, 9vw, 96px);
    height: auto;
    flex: none;
  }

  .site-footer__legal {
    border-top: 1px solid var(--surface-line);
    background: rgba(6, 12, 28, 0.74);
    font-size: 0.8125rem;
    color: var(--ink-faint);
  }

  @media (max-width: 599px) {
    .site-footer__legal .shell {
      flex-direction: column;
      gap: 0.1rem;
    }
  }

  .site-footer__social {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid var(--surface-line);
    border-radius: 999px;
    color: var(--ink-muted);
    transition:
      color 200ms var(--ease-athletic),
      border-color 200ms var(--ease-athletic),
      background 200ms var(--ease-athletic);
  }

  .site-footer__social:hover {
    color: #fff;
    border-color: var(--accent-bright);
    background: rgba(44, 101, 213, 0.22);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__social {
      transition: none;
    }
  }
</style>
